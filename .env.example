DATABASE_URL="postgresql://ia_supervisor:ia_supervisor@localhost:5432/ia_supervisor?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
