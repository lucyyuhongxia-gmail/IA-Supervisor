DATABASE_URL="postgresql://ia_supervisor:ia_supervisor@localhost:5432/ia_supervisor?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
TEACHER_SIGNUP_CODE="replace-with-a-private-teacher-code"

# File storage.
# Use "local" for local development.
# Use "supabase" for Vercel/online deployments.
FILE_STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ia-supervisor-uploads"

# Optional one-time admin bootstrap for `npm run admin:create`.
ADMIN_EMAIL=""
ADMIN_NAME="System Admin"
ADMIN_PASSWORD=""

# AI review provider.
# Use "mock" for local workflow testing without an API key.
# Use "deepseek" to call a DeepSeek/OpenAI-compatible chat completions API.
AI_REVIEW_PROVIDER="mock"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-flash"
